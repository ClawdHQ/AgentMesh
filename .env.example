# Shared runtime
NODE_ENV=development
LOG_LEVEL=info
CHAIN_ID=11155111
AUTONOMY_LEVEL=2
INTERNAL_SERVICE_API_KEY=replace-with-a-random-internal-shared-secret

# Public URLs
PUBLIC_API_URL=http://localhost:3001
PUBLIC_DASHBOARD_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001/ws
VITE_DASHBOARD_ORIGIN=http://localhost:5173

# Ethereum / ERC-8004
PRIVATE_KEY=0xYOUR_OPERATOR_WALLET_PRIVATE_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
USDC_ADDRESS_SEPOLIA=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
AGENT_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
TASK_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
REPUTATION_ORACLE_ADDRESS=0x0000000000000000000000000000000000000000
AUDIT_LOGGER_ADDRESS=0x0000000000000000000000000000000000000000

# Filecoin + encrypted artifacts
FILECOIN_STORAGE_PROVIDER=lighthouse
LIGHTHOUSE_API_KEY=your-lighthouse-key
LIGHTHOUSE_GATEWAY_URL=https://gateway.lighthouse.storage/ipfs/
FILECOIN_PIN_COMMAND=filecoin-pin
FILECOIN_PIN_GATEWAY_URL=https://ipfs.io/ipfs/
LIT_NETWORK=datil-dev

# Planner + ML providers
ANTHROPIC_API_KEY=sk-ant-...
IMPULSE_API_KEY=your-impulse-api-key
IMPULSE_DEPLOYMENT_ID=your-impulse-deployment-id
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Internal agent services
ORCHESTRATOR_SERVICE_URL=http://localhost:3002
SPECIALIST_SERVICE_URL=http://localhost:3003
VENDOR_SERVICE_URLS=http://localhost:3004

# Service ports
API_PORT=3001
WS_PORT=3001
ORCHESTRATOR_PORT=3002
SPECIALIST_AGENTS_PORT=3003
VENDOR_AGENT_PORT=3004

# Specialist pricing metadata
DATA_AGENT_PRICE_USDC=1000
COMPUTE_AGENT_PRICE_USDC=5000
EXECUTOR_AGENT_PRICE_USDC=2000
